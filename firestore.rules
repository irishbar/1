rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getRole() == 'admin';
    }

    function isManager() {
      return isSignedIn() && (getRole() == 'manager' || getRole() == 'admin');
    }

    function isAgent() {
      return isSignedIn() && getRole() == 'agent';
    }

    function isDriver() {
      return isSignedIn() && getRole() == 'driver';
    }

    function isCustomer() {
      return isSignedIn() && getRole() == 'customer';
    }

    // ─── users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isSignedIn() && (request.auth.uid == userId || isManager());
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ─── products ─────────────────────────────────────────────────────────────
    match /products/{id} {
      allow read:  if true;
      allow write: if isManager();
    }

    // ─── categories ───────────────────────────────────────────────────────────
    match /categories/{id} {
      allow read:  if true;
      allow write: if isManager();
    }

    // ─── promotions ───────────────────────────────────────────────────────────
    match /promotions/{id} {
      allow read:  if true;
      allow write: if isManager();
    }

    // ─── orders ───────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        isManager() ||
        resource.data.customerId == request.auth.uid ||
        (isAgent() && resource.data.agentId == request.auth.uid) ||
        (isDriver() && resource.data.driverId == request.auth.uid)
      );
      allow create: if (
        // Admin/manager
        isManager() ||
        // Signed-in customer creating their own order
        (isSignedIn() && isCustomer() && request.resource.data.customerId == request.auth.uid) ||
        // Guest order (no account required)
        request.resource.data.customerId == 'guest'
      );
      allow update: if isSignedIn() && (
        isManager() ||
        (isAgent() && resource.data.agentId == request.auth.uid) ||
        (isDriver() && resource.data.driverId == request.auth.uid) ||
        (
          isCustomer() &&
          resource.data.customerId == request.auth.uid &&
          request.resource.data.status == 'ملغي' &&
          (resource.data.status == 'جديد' || resource.data.status == 'قيد التجهيز') &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledBy', 'cancelledAt'])
        )
      );
      allow delete: if isAdmin();
    }

    // ─── agents ───────────────────────────────────────────────────────────────
    // Agent can update their own doc but NOT change commissionRate (set by admin only)
    match /agents/{agentId} {
      allow read:   if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isAgent() &&
        request.auth.uid == resource.data.userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['commissionRate'])
      );
      allow delete: if isAdmin();
    }

    // ─── drivers ──────────────────────────────────────────────────────────────
    match /drivers/{driverId} {
      allow read: if isSignedIn() && (
        isManager() ||
        (isAgent() && resource.data.agentId == request.auth.uid) ||
        (isDriver() && resource.data.userId == request.auth.uid)
      );
      allow create: if isManager() || isAgent();
      allow update: if isManager() ||
        (isAgent() && resource.data.agentId == request.auth.uid) ||
        (isDriver() && resource.data.userId == request.auth.uid);
      allow delete: if isManager() ||
        (isAgent() && resource.data.agentId == request.auth.uid);
    }

    // ─── balance_topups ───────────────────────────────────────────────────────
    // Agent can only create topups for their own drivers (agentId must match)
    match /balance_topups/{id} {
      allow read: if isSignedIn() && (
        isManager() ||
        (isAgent() && resource.data.agentId == request.auth.uid) ||
        (isDriver() && resource.data.targetId == request.auth.uid)
      );
      allow create: if isSignedIn() && (
        isManager() ||
        (isAgent() && request.resource.data.agentId == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }

    // ─── balance_deductions ───────────────────────────────────────────────────
    // Driver reads own. Agent reads their own deductions.
    match /balance_deductions/{id} {
      allow read: if isSignedIn() && (
        isManager() ||
        (isDriver() && resource.data.driverId == request.auth.uid) ||
        (isAgent() && resource.data.agentId == request.auth.uid)
      );
      allow create: if isManager() || isAgent();
      allow update, delete: if isAdmin();
    }

    // ─── agent_purchases ──────────────────────────────────────────────────────
    // Agent creates and reads their own purchases. Admin reads all.
    match /agent_purchases/{id} {
      allow read: if isSignedIn() && (
        isManager() ||
        (isAgent() && resource.data.agentId == request.auth.uid)
      );
      allow create: if isAgent() && request.resource.data.agentId == request.auth.uid;
      allow update: if isAdmin() || (isAgent() && resource.data.agentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── coverage_requests ────────────────────────────────────────────────────
    // Agent creates requests for coverage changes. Admin manages them.
    match /coverage_requests/{id} {
      allow read: if isSignedIn() && (
        isManager() ||
        (isAgent() && resource.data.agentId == request.auth.uid)
      );
      allow create: if isAgent() && request.resource.data.agentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── purchases ────────────────────────────────────────────────────────────
    match /purchases/{id} {
      allow read, write: if isManager();
    }

    // ─── settings ─────────────────────────────────────────────────────────────
    match /settings/packages {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
    match /settings/agents {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
    match /settings/delivery {
      allow read:  if true;
      allow write: if isAdmin();
    }
    match /settings/status {
      allow read:  if true;
      allow write: if isAdmin();
    }
    match /settings/telegram {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

  }
}
